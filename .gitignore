# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report
/.playwright
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local Claude Code configuration, not a project artifact
.claude/

# Local denylist terms. NEVER COMMIT — this file holds the identifying information the
# repo exists to keep out. The committed template is .denylist.local.example.
#
# The wildcard covers editor backups and hand-made copies (.bak, .save, ~, .orig).
# A copy of this file that .gitignore does not match is indistinguishable from the
# original in every way that matters, and is exactly how a local-only secret reaches
# a commit. The negation keeps the template committable.
.denylist.local*
!.denylist.local.example

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
